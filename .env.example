# Copy to .env.local (local) or set these in your host (Railway → Variables).
# Real values come from Supabase → Project Settings → API. NEVER commit secrets.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / public key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER ONLY, full access. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
